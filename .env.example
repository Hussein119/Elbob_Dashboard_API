PORT=4000

# Google Sheet that stores all data (the ID from the sheet URL)
SHEET_ID=

# Full service-account JSON key on one line (share the sheet with its email as Editor).
# Without it the API falls back to each user's short-lived Google OAuth token.
GOOGLE_SERVICE_ACCOUNT_KEY=

# At least 32 random characters
JWT_SECRET=
JWT_EXPIRES_IN=1y

# Comma-separated. Bootstrap accounts that can always sign in.
ADMIN_EMAILS=
USER_EMAILS=

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
